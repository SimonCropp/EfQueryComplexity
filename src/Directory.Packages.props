    <PackageVersion Include="ProjectDefaults" Version="1.0.181" />
    <PackageVersion Include="Verify" Version="33.1.4" />
    <PackageVersion Include="Verify.TUnit" Version="33.1.1" />
    <PackageVersion Include="Verify.EntityFramework" Version="15.5.0" />
