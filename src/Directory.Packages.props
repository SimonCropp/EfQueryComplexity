    <PackageVersion Include="ProjectDefaults" Version="1.0.190" />
    <PackageVersion Include="Verify" Version="33.4.0" />
    <PackageVersion Include="Verify.TUnit" Version="33.4.0" />
    <PackageVersion Include="Verify.EntityFramework" Version="16.2.0" />
    <PackageVersion Include="Verify.SqlServer" Version="12.4.0" />
